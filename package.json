{
  "name": "webp-lossless",
  "version": "1.0.0",
  "description": "Lossless WebP encoder in plain TypeScript, without WebAssembly",
  "private": true,
  "license": "MIT",
  "author": "Jiří Němec",
  "repository": "github:BluPix/webp-lossless",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "tsc && node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@nktkas/webp": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
